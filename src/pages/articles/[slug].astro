---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Metadata from '../../components/Metadata.astro';
import TagList from '../../components/TagList.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getRelated } from '../../utils/related';

export async function getStaticPaths() {
  const all = await getCollection('articles');
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry, all } }));
}

const { entry, all } = Astro.props;
const { Content } = await render(entry);
const { manual, auto } = getRelated(entry, all);
const { title, description, date: datePublished, updated: dateModified, tags, cover } = entry.data;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  inLanguage: 'zh-TW',
  datePublished: datePublished.toISOString(),
  dateModified: (dateModified ?? datePublished).toISOString(),
  keywords: tags.join(','),
  mainEntityOfPage: pageUrl,
  publisher: { '@type': 'Organization', name: '佳士國際' },
};
---

<BaseLayout title={title} description={description} type="article" jsonLd={jsonLd}>
  <article data-pagefind-body>
    <h1>{title}</h1>
    <Metadata datePublished={datePublished} dateModified={dateModified} />
    <TagList tags={tags} />
    {cover && <Image src={cover} alt={title} widths={[480, 800]} sizes="100vw" />}
    <div class="article-body">
      <Content />
    </div>
    <Disclaimer />
  </article>

  {manual.length > 0 && (
    <section data-pagefind-ignore>
      <h2>推薦閱讀</h2>
      {manual.map((a) => (
        <ArticleCard article={a} />
      ))}
    </section>
  )}
  {auto.length > 0 && (
    <section data-pagefind-ignore>
      <h2>相關文章</h2>
      {auto.map((a) => (
        <ArticleCard article={a} />
      ))}
    </section>
  )}
</BaseLayout>
