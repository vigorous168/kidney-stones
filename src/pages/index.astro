---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { url } from '../utils/url';

const articles = (await getCollection('articles')).sort((a, b) => {
  const aDatePublished = a.data.updated?.valueOf() ?? a.data.date.valueOf();
  const bDatePublished = b.data.updated?.valueOf() ?? b.data.date.valueOf();

  return bDatePublished - aDatePublished;
});

const tagCounts = new Map<string, number>();
for (const article of articles) {
  for (const tag of new Set(article.data.tags)) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const tagList = [...tagCounts.entries()]
  .map(([tag, count]) => ({ tag, count }))
  .sort((a, b) => b.count - a.count || a.tag.localeCompare(b.tag, 'zh-TW'));

const pagefindBase = url('pagefind/');
---

<BaseLayout title="衛教文章列表" description="尿路結石等泌尿系統衛教文章，提供一般健康資訊。">
  <h1>衛教文章</h1>
  <link rel="stylesheet" href={`${pagefindBase}pagefind-ui.css`} />
  <div id="search"></div>
  <script is:inline define:vars={{ pagefindBase }}>
    window.addEventListener('DOMContentLoaded', () => {
      const s = document.createElement('script');
      s.src = pagefindBase + 'pagefind-ui.js';
      s.onload = () =>
        new PagefindUI({
          element: '#search',
          showImages: false,
          resetStyles: true,
          translations: {
            placeholder: '搜尋文章標題或標籤',
            clear_search: '清除',
            load_more: '載入更多結果',
            search_label: '搜尋本站',
            filters_label: '篩選',
            zero_results: '找不到「[SEARCH_TERM]」的相關結果',
            many_results: '「[SEARCH_TERM]」共 [COUNT] 筆結果',
            one_result: '「[SEARCH_TERM]」共 [COUNT] 筆結果',
            searching: '搜尋「[SEARCH_TERM]」中⋯',
          },
        });
      document.head.appendChild(s);
    });
  </script>
  <h2>依標籤瀏覽</h2>
  <ul class="tags">
    {tagList.map(({ tag, count }) => (
      <li>
        <a href={url(`tags/${encodeURIComponent(tag)}/`)}>
          #{tag}
          <span class="tag-count" aria-label={`${count} 篇文章`}>
            {count}
          </span>
        </a>
      </li>
    ))}
  </ul>

  <h2>所有文章</h2>
  {articles.map((article) => (
    <ArticleCard article={article} />
  ))}
</BaseLayout>
